#!/usr/bin/env bash
# Maid Runner entry: the Qt app. It needs PyQt6 + a display; extra args
# pass through. Maid Scroll (the palette cycler) is bin/maid-scroll.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
PKG="$HERE/../lib/maid-runner"

has_display() { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }
has_pyqt() { python3 -c "import PyQt6" 2>/dev/null; }

session_doctor() {
  echo "Maid Runner — session/compositor (best-effort)"
  echo "  XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-n/a}"
  echo "  XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP:-n/a}"
  echo "  WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}  DISPLAY=${DISPLAY:-}"
  case "${XDG_CURRENT_DESKTOP:-} ${XDG_SESSION_DESKTOP:-}" in
    *[Pp]lasma*|*[Kk][Dd][Ee]*) echo "  support: KDE Plasma path expected (supported). Bind key via Plasma shortcuts (see README)." ;;
    *[Hh]yprland*|*[Ss]way*|*[Ii]3*) echo "  support: Qt runner works on Wayland/X11; compositor keybind/integration is partial/experimental (iterative). Bind maid-runner/--toggle in your compositor config." ;;
    *) echo "  support: core app needs a display; integration varies by desktop/compositor." ;;
  esac
}
case "${1:-}" in --doctor|--session) session_doctor; exit 0 ;; esac

if [ -d "$PKG" ] && has_pyqt && has_display; then
  PYTHONPATH="$PKG" exec python3 -m maid_runner "$@"
fi

if [ ! -d "$PKG" ]; then
  echo "Maid Runner: package missing under $PKG (reinstall with install.sh)." >&2
elif ! has_pyqt; then
  echo "Maid Runner needs PyQt6 (install python3-pyqt6)." >&2
else
  echo "Maid Runner needs a display (Wayland or X11)." >&2
fi
exit 2
