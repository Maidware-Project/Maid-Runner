#!/usr/bin/env bash
# this is truly my power
# Maid Runner entry: the Qt app. It needs PyQt6 + a display; extra args
# pass through. Maid Scroll (the palette cycler) is bin/maid-scroll.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
PKG="$HERE/../lib/maid-runner"

has_display() { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }
has_pyqt() { python3 -c "import PyQt6" 2>/dev/null; }

session_doctor() {
  echo "Maid Runner — session/compositor (best-effort)"
  echo "  XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-n/a}"
  echo "  XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP:-n/a}"
  echo "  DESKTOP_SESSION=${DESKTOP_SESSION:-n/a}"
  echo "  WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}  DISPLAY=${DISPLAY:-}"
  local de="${XDG_CURRENT_DESKTOP:-} ${XDG_SESSION_DESKTOP:-} ${DESKTOP_SESSION:-}"
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -x gpuishell >/dev/null 2>&1 && echo "  shell: GPUIShell (gpuishell, rond.cc/gpui-shell) detected (supported environment)."
    pgrep -x horizon >/dev/null 2>&1 && echo "  shell: Event Horizon desktop environment detected (supported environment)."
    pgrep -x kineticwe >/dev/null 2>&1 && echo "  shell: KineticWE compositor/session detected (supported environment)."
  fi
  case "$de" in
    *[Pp]lasma*|*[Kk][Dd][Ee]*) echo "  support: KDE Plasma path expected (supported). Bind key via Plasma shortcuts (see README)." ;;
    *[Gg][Nn][Oo][Mm][Ee]*) echo "  support: GNOME session detected. Qt runner works; bind maid-runner/--toggle via GNOME keyboard shortcuts." ;;
    *[Xx][Ff][Cc][Ee]*) echo "  support: XFCE session detected. Qt runner works; bind maid-runner/--toggle via XFCE keyboard shortcuts." ;;
    *[Mm][Aa][Tt][Ee]*) echo "  support: MATE session detected. Qt runner works; bind maid-runner/--toggle via MATE keyboard shortcuts." ;;
    *[Cc]innamon*) echo "  support: Cinnamon session detected. Qt runner works; bind maid-runner/--toggle via Cinnamon keyboard shortcuts." ;;
    *[Ll][Xx][Qq]t*) echo "  support: LXQt session detected. Qt runner works; bind maid-runner/--toggle via LXQt shortcuts." ;;
    *[Hh]yprland*) echo "  support: Hyprland detected (Wayland). Qt runner works; bind maid-runner/--toggle in hyprland.conf." ;;
    *[Ss]way*) echo "  support: Sway detected (Wayland). Qt runner works; bind maid-runner/--toggle in Sway config." ;;
    *[Ii]3*) echo "  support: i3 detected. Qt runner works on X11; bind maid-runner/--toggle in i3 config." ;;
    *) if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
         echo "  support: core app needs a display; integration varies by desktop/compositor. Bind maid-runner/--toggle in your environment's keybind config."
       else
         echo "  support: no display detected."
       fi ;;
  esac
}
case "${1:-}" in --doctor|--session) session_doctor; exit 0 ;; esac

if [ -d "$PKG" ] && has_pyqt && has_display; then
  PYTHONPATH="$PKG" exec python3 -m maid_runner "$@"
fi

if [ ! -d "$PKG" ]; then
  echo "Maid Runner: package missing under $PKG (reinstall with install.sh)." >&2
elif ! has_pyqt; then
  echo "Maid Runner needs PyQt6 (install python3-pyqt6)." >&2
else
  echo "Maid Runner needs a display (Wayland or X11)." >&2
fi
exit 2
